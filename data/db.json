    "ai": { "guard_hp_threshold": 0.5 },

    "actions": { "base": 1, "cap": 3, "extra_per_agility": 0.2 },

    "hit": { "base": 0.90, "per_accuracy": 0.02, "per_flexibility": 0.01, "per_stealth": 0.01, "min": 0.50, "max": 0.97 },
    "crit": { "base": 0.05, "per_flexibility": 0.01, "max": 0.50, "mult_base": 1.5, "mult_per_obsession": 0.05, "mult_max": 2.5 },
    "damage": { "per_strength": 0.10, "min_damage": 1 },
    "mitigation": { "per_phys_res": 0.02, "cap": 0.60 },

    "regen": { "pct_of_max_hp_per_point": 0.005, "bleed_heal_factor": 0.5 },

    "instakill": { "per_grade_step": 0.002, "ranged_bonus": 0.01, "cap": 0.05, "base_grade": 9 },

    "part_damage": {
      "chance": 0.15,
      "parts": ["torso", "left_arm", "right_arm", "left_leg", "right_leg"],
      "effects": {
        "torso": { "stat": "regen", "delta": -3 },
        "left_arm": { "stat": "accuracy", "delta": -3 },
        "right_arm": { "stat": "accuracy", "delta": -3 },
        "left_leg": { "stat": "flexibility", "delta": -3 },
        "right_leg": { "stat": "flexibility", "delta": -3 }
      },
      "gear_slot": { "torso": "top", "left_leg": "shoes", "right_leg": "shoes" },
      "durability_loss": 2
    },

    "status": {
      "poison": { "damage_per_stack": 2.0, "stack_cap": 5, "resist_stat": "poison_res", "resist_per_point": 0.05, "min_factor": 0.2 },
      "bleed": { "damage_per_stack": 2.0, "stack_cap": 5 },
      "stun": { "resist_stat": "endurance", "resist_per_point": 0.05, "max_resist": 0.75 }
    },

    "monster_grade": {
      "base_grade": 9,
      "strength_per_step": 1,
      "phys_res_per_step": 2,
      "regen_from_grade": 5,
      "regen_per_step": 2
    },

    "mastery": {
      "kills_per_level": 12,
      "max_level": 2,
      "bonus_per_level": { "accuracy": 1, "flexibility": 1, "phys_res": 1 }
    }
  },

